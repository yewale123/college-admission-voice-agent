# ================================================
#  College Admission Voice Agent - Configuration
# ================================================

# LLM: Groq (FREE) - Get key at https://console.groq.com
# Free models: llama-3.1-8b-instant, llama-3.1-70b-versatile, gemma2-9b-it
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_admission_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# App Settings
UPLOAD_DIR=uploads
CHROMA_DIR=uploads/chroma_db
MAX_FILE_SIZE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
